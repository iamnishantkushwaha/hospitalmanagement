// Hospital & Patient Management System — Demo Schema
// See Hospital_Patient_Management_Master_Project_Document.docx section 21-23

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  PHARMACIST
  BILLING_STAFF
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_ENTERED
  VERIFIED
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceSourceType {
  CONSULTATION
  LAB
  PHARMACY
  ROOM
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
  OTHER
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff        Staff?
  doctor       Doctor?
  patient      Patient?
  notifications Notification[]
  auditLogs    AuditLog[]
  pendingRegistration PendingPatientRegistration?

  @@index([role])
}

// ---------------------------------------------------------------------------
// Hospital Structure
// ---------------------------------------------------------------------------

model Hospital {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  wards       Ward[]
}

model Department {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  name       String
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctors      Doctor[]
  appointments Appointment[]

  @@index([hospitalId])
}

model Staff {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  designation  String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Doctor {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id])
  specialization   String
  qualification    String?
  experienceYears  Int?
  consultationFee  Decimal  @db.Decimal(10, 2)
  workingDays      String[] // e.g. ["MON","TUE","WED"]
  slotStartTime    String?  // "09:00"
  slotEndTime      String?  // "17:00"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  admissions    Admission[]

  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

model Patient {
  id                 String    @id @default(cuid())
  mrn                String    @unique // PAT-000001
  userId             String?   @unique
  user               User?     @relation(fields: [userId], references: [id])
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  gender             Gender?
  bloodGroup         String?
  phone              String?
  email              String?
  address            String?
  allergies          String?
  existingConditions String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contacts      PatientContact[]
  insurance     Insurance[]
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
  admissions    Admission[]
  labOrders     LabOrder[]
  invoices      Invoice[]

  @@index([lastName, firstName])
  @@index([phone])
}

model PatientContact {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  name      String
  relation  String?
  phone     String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model Insurance {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  provider     String
  policyNumber String
  validTill    DateTime?
  createdAt    DateTime @default(now())

  @@index([patientId])
}

// ---------------------------------------------------------------------------
// Appointments & OPD
// ---------------------------------------------------------------------------

model Appointment {
  id               String            @id @default(cuid())
  appointmentNo    String            @unique // APT-000001
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id])
  doctorId         String
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id])
  scheduledDate    DateTime
  timeSlot         String
  status           AppointmentStatus @default(SCHEDULED)
  reason           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  consultation Consultation?

  @@index([scheduledDate, status])
  @@index([doctorId])
  @@index([patientId])
}

model Consultation {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  chiefComplaint String?
  clinicalNotes  String?
  followUpDate   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vitals       Vital[]
  diagnoses    Diagnosis[]
  prescriptions Prescription[]
  labOrders    LabOrder[]

  @@index([patientId])
  @@index([doctorId])
}

model Vital {
  id             String   @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  temperatureC   Decimal? @db.Decimal(4, 1)
  bloodPressure  String?
  pulseBpm       Int?
  respRate       Int?
  weightKg       Decimal? @db.Decimal(5, 1)
  heightCm       Decimal? @db.Decimal(5, 1)
  spo2           Int?
  recordedAt     DateTime @default(now())

  @@index([consultationId])
}

model Diagnosis {
  id             String   @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  description    String
  icdCode        String?
  createdAt      DateTime @default(now())

  @@index([consultationId])
}

// ---------------------------------------------------------------------------
// Prescriptions
// ---------------------------------------------------------------------------

model Prescription {
  id             String   @id @default(cuid())
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items    PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicineId     String?
  medicine       Medicine? @relation(fields: [medicineId], references: [id])
  medicineName   String
  dosage         String?
  frequency      String?
  durationDays   Int?
  instructions   String?
  isDispensed    Boolean  @default(false)

  transactions PharmacyTransaction[]

  @@index([prescriptionId])
}

// ---------------------------------------------------------------------------
// IPD (Admissions / Wards / Beds)
// ---------------------------------------------------------------------------

model Ward {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  name       String
  type       String?
  createdAt  DateTime @default(now())

  rooms Room[]

  @@index([hospitalId])
}

model Room {
  id        String   @id @default(cuid())
  wardId    String
  ward      Ward     @relation(fields: [wardId], references: [id])
  roomNo    String
  type      String?
  createdAt DateTime @default(now())

  beds Bed[]

  @@index([wardId])
}

model Bed {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id])
  bedNo     String
  status    BedStatus @default(AVAILABLE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  admissions Admission[]

  @@index([roomId])
  @@index([status])
}

model Admission {
  id             String          @id @default(cuid())
  admissionNo    String          @unique // ADM-000001
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor          @relation(fields: [doctorId], references: [id])
  bedId          String
  bed            Bed             @relation(fields: [bedId], references: [id])
  admissionDate  DateTime        @default(now())
  reason         String?
  status         AdmissionStatus @default(ADMITTED)
  dailyChargeAmt Decimal?        @db.Decimal(10, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  discharge Discharge?

  @@index([patientId])
  @@index([status])
}

model Discharge {
  id            String    @id @default(cuid())
  admissionId   String    @unique
  admission     Admission @relation(fields: [admissionId], references: [id])
  dischargeDate DateTime  @default(now())
  summary       String?
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Laboratory
// ---------------------------------------------------------------------------

model LabTest {
  id          String   @id @default(cuid())
  name        String
  category    String?
  price       Decimal  @db.Decimal(10, 2)
  normalRange String?
  unit        String?
  createdAt   DateTime @default(now())

  orderItems LabOrderItem[]
}

model LabOrder {
  id             String         @id @default(cuid())
  orderNo        String         @unique // LAB-000001
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor         @relation(fields: [doctorId], references: [id])
  consultationId String?
  consultation   Consultation?  @relation(fields: [consultationId], references: [id])
  status         LabOrderStatus @default(ORDERED)
  orderedAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items InvoiceItem[]
  tests LabOrderItem[]

  @@index([patientId])
  @@index([status])
}

model LabOrderItem {
  id         String   @id @default(cuid())
  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id])
  labTestId  String
  labTest    LabTest  @relation(fields: [labTestId], references: [id])

  result LabResult?

  @@index([labOrderId])
}

model LabResult {
  id             String    @id @default(cuid())
  labOrderItemId String    @unique
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id])
  resultValue    String?
  isNormal       Boolean?
  verifiedById   String?
  verifiedAt     DateTime?
  enteredAt      DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Pharmacy
// ---------------------------------------------------------------------------

model Medicine {
  id        String   @id @default(cuid())
  name      String
  category  String?
  unit      String?
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  batches           MedicineBatch[]
  prescriptionItems PrescriptionItem[]
}

model MedicineBatch {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  batchNo    String
  expiryDate DateTime
  quantity   Int
  createdAt  DateTime @default(now())

  transactions PharmacyTransaction[]

  @@index([medicineId])
  @@index([expiryDate])
}

model PharmacyTransaction {
  id                 String   @id @default(cuid())
  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicineBatchId    String
  medicineBatch      MedicineBatch @relation(fields: [medicineBatchId], references: [id])
  quantity           Int
  dispensedById      String?
  dispensedAt        DateTime @default(now())

  @@index([prescriptionItemId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(cuid())
  invoiceNo     String        @unique // INV-000001
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  admissionId   String?
  status        InvoiceStatus @default(PENDING)
  subtotalAmt   Decimal       @db.Decimal(10, 2)
  discountAmt   Decimal       @default(0) @db.Decimal(10, 2)
  taxAmt        Decimal       @default(0) @db.Decimal(10, 2)
  totalAmt      Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id           String            @id @default(cuid())
  invoiceId    String
  invoice      Invoice           @relation(fields: [invoiceId], references: [id])
  sourceType   InvoiceSourceType
  labOrderId   String?
  labOrder     LabOrder?         @relation(fields: [labOrderId], references: [id])
  description  String
  quantity     Int               @default(1)
  unitPrice    Decimal           @db.Decimal(10, 2)
  amount       Decimal           @db.Decimal(10, 2)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  receivedById  String?
  paidAt        DateTime      @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Notifications & Audit
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Patient self-registration (mobile OTP)
// ---------------------------------------------------------------------------

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  purpose    String // e.g. "SELF_REGISTRATION"
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

// Created when a patient self-registers in the app but the system cannot
// automatically match them to an existing hospital record by phone + DOB.
// Reception reviews these and either links the login to an existing patient
// (by MRN) or creates a fresh patient record from the submitted details.
model PendingPatientRegistration {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  firstName   String
  lastName    String
  phone       String
  dateOfBirth DateTime
  status      String   @default("PENDING") // PENDING | MERGED
  createdAt   DateTime @default(now())

  @@index([status])
}
